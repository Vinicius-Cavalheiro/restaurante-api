generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Perfil {
  ADMIN
  GERENTE
  ATENDENTE
  CLIENTE
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusPedido {
  PENDENTE
  CONFIRMADO
  EM_PREPARO
  PRONTO
  FINALIZADO
  CANCELADO
}

enum CanalPedido {
  BALCAO
  APP
  DELIVERY
  TOTEM
  PICKUP
  WEB
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
}

enum MetodoPagamento {
  PIX
  CARTAO
}

model Usuario {
  id               Int      @id @default(autoincrement())
  nome             String   @db.VarChar(120)
  email            String   @unique @db.VarChar(150)
  senha            String   @db.VarChar(255)
  perfil           Perfil   @default(CLIENTE)
  ativo            Boolean  @default(true)

  pontosFidelidade Int      @default(0)

  // Fidelidade / consentimento
  fidelidadeAtiva  Boolean  @default(false)
  consentimentoFidelidadeEm DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movimentacoesEstoque MovimentacaoEstoque[]
  pedidos              Pedido[]
  auditorias           Auditoria[]

  @@map("usuarios")
}

model Unidade {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  endereco  String   @db.VarChar(255)
  cidade    String   @db.VarChar(100)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estoques             Estoque[]
  movimentacoesEstoque MovimentacaoEstoque[]
  pedidos              Pedido[]

  @@map("unidades")
}

model Produto {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  descricao String?  @db.VarChar(255)
  categoria String   @db.VarChar(100)
  sku       String   @unique @db.VarChar(50)
  preco     Decimal  @db.Decimal(10, 2)
  custo     Decimal  @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estoques             Estoque[]
  movimentacoesEstoque MovimentacaoEstoque[]
  itemPedidos          ItemPedido[]

  @@map("produtos")
}

model Estoque {
  id         Int      @id @default(autoincrement())
  unidadeId  Int
  produtoId  Int
  quantidade Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([unidadeId, produtoId])
  @@index([unidadeId])
  @@index([produtoId])
  @@map("estoques")
}

model MovimentacaoEstoque {
  id         Int              @id @default(autoincrement())
  unidadeId  Int
  produtoId  Int
  usuarioId  Int
  tipo       TipoMovimentacao
  quantidade Int
  createdAt  DateTime         @default(now())

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([unidadeId])
  @@index([produtoId])
  @@index([usuarioId])
  @@map("movimentacoes_estoque")
}

model Pedido {
  id               Int          @id @default(autoincrement())
  usuarioId        Int
  unidadeId        Int
  status           StatusPedido @default(PENDENTE)
  canalPedido      CanalPedido  @map("canal")
  valorTotal       Decimal      @default(0) @db.Decimal(10, 2)
  pontosCreditados Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  unidade Unidade @relation(fields: [unidadeId], references: [id])

  itens     ItemPedido[]
  pagamento Pagamento?

  @@index([usuarioId])
  @@index([unidadeId])
  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

model Pagamento {
  id        Int             @id @default(autoincrement())
  pedidoId  Int             @unique
  metodo    MetodoPagamento
  status    StatusPagamento @default(PENDENTE)
  valor     Decimal         @db.Decimal(10, 2)
  transacao String?         @db.VarChar(100)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  acao       String   @db.VarChar(80)
  entidade   String   @db.VarChar(80)
  entidadeId Int
  detalhes   Json?
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@map("auditorias")
}
